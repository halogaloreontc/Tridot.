                "item": {
                    "title": "{sku|or:без артикула}",
                    "text": "{name}",
                    "note": "{cell} · {clsLabel}",
                    "badge": "{qty|num} шт.",
                    "link": {
                        "kind": "sku",
                        "id": "{sku}"
                    }
                }
            }
        },
