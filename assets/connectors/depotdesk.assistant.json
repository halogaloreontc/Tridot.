            "answer": {
                "say": "«{q}»: {count|plural:позиция,позиции,позиций}.{costShown|unless: Закупочные цены видны только с правом «ставить цены».}",
                "empty": "«{q}» не нашлось.",
                "list": "items",
                "more": "more",
                "item": {
                    "title": "{sku}",
                    "text": "{name}",
                    "badge": "{price|num|or:цена не задана}{price|if: ₽}",
                    "note": "{off|if:скидка }{off|num|or:}{off|if: % от }{base|num|or:}{base|if: ₽ · }{cost|if:закупка }{cost|num|or:}{cost|if: ₽}",
                    "link": {
                        "kind": "sku",
                        "id": "{sku}"
                    }
                }
            }
        },
        {
            "id": "cell",
            "title": "Что лежит в ячейке",
            "say": [
                "что лежит в {cell}",
                "что лежит в ячейке {cell}",
                "что в ячейке {cell}",
                "что в стеллаже {cell}",
                "что на стеллаже {cell}",
                "что лежит в стеллаже {cell}",
                "что лежит на стеллаже {cell}",
                "что на складе {cell}",
