        {
            "_": "Склад без ask_price (DepotDesk до 1.4.62) отвечает «Неизвестное действие» — помощник говорит свою запись каталога «price».",
            "id": "price",
            "title": "Цена товара",
            "say": [
                "сколько стоит {q}",
                "цена {q}",
                "почем {q}",
                "почём {q}",
                "какая цена {q}",
                "какая цена у {q}"
            ],
            "examples": [
                "сколько стоит 64115"
            ],
            "slots": {
                "q": {
                    "label": "артикул или название",
                    "type": "text"
                }
            },
            "access": "staff",
            "call": {
                "action": "ask_price",
                "body": {
                    "q": "{q}"
                }
