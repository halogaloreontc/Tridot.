                "empty": "«{q}» на складе нет — 0 шт.",
                "list": "items",
                "more": "more",
                "item": {
                    "title": "{sku|or:без артикула}",
                    "text": "{name}",
                    "badge": "{qty|num} шт.",
                    "link": {
                        "kind": "sku",
                        "id": "{sku}"
                    },
                    "list": "sheets",
                    "item": {
                        "title": "склад {sheet}",
                        "badge": "{qty|num} шт."
                    }
                }
