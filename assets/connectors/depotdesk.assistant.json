{
    "format": "assistant/1",
    "version": "1.4.62",
    "app": {
        "id": "depotdesk",
        "title": "Склад DepotDesk",
        "lang": "ru",
        "about": "Склад возвратов: приходы по реестрам, ячейки на схеме, остатки, снимки товара."
    },
    "api": {
        "url": "api.php",
        "method": "POST",
        "action": {
            "in": "query",
            "name": "action"
        },
        "body": "json",
        "only": [
            "ask_stock",
            "ask_cell",
            "ask_arrivals",
            "ask_nophoto",
            "ask_unposted",
            "ask_me",
            "ask_price",
            "act_post_check",
            "act_move_check"
        ],
        "act": [
            "act_post",
            "act_move",
            "act_settle"
        ],
        "errors": {
            "message": "error",
            "need": "need",
            "code": "code"
        }
    },
    "auth": {
        "headers": {
            "X-Wh-Token": "{$token}",
            "X-Wh-Sid": "{$sid}"
        },
        "credentials": {
            "token": {
                "label": "Пароль склада",
                "app": "localStorage:wh_token"
            },
            "sid": {
                "label": "Личный ключ сотрудника",
                "app": "localStorage:wh_sid",
                "get": {
                    "action": "auth_check",
                    "body": {
                        "login": "{login}",
                        "pass": "{pass}",
                        "scope": "assist"
                    },
                    "take": "sid"
                },
                "drop": {
                    "_": "Выход склада 1.4.63: снимает только тот личный ключ, что пришёл в заголовке. Старый склад отвечает 400 — ключ истечёт сам.",
                    "action": "auth_out"
                }
            }
        },
        "access": {
            "shared": {
                "label": "по паролю склада",
                "needs": [
                    "token"
                ]
            },
            "staff": {
                "label": "под своим логином",
                "needs": [
                    "token",
                    "sid"
                ]
            }
        },
        "need": {
            "login": "Это видно только под своим логином — войдите в склад и спросите снова.",
            "role": "Учётная запись ждёт роли — попросите администратора её назначить.",
            "off": "Администратор выключил это помощнику.",
            "perm": "У вашей роли на это нет права — его даёт администратор в «Ролях»."
        },
        "qr": {
            "_": "Вход по одноразовому коду помощника со страницы «Подключить Связного» (склад 1.4.62): QR и кнопка «Открыть в Tridot» ведут на tridot://connect?u=<адрес склада>&qr=<код>. Код из окна «Войти на телефоне» (#qr=) тоже годится. Помощник шлёт scope «assist»: склад выдаёт ключ только для вопросов помощнику; старый склад поле не знает и выдаёт обычный ключ.",
            "link": "#qr=",
            "shape": "^[0-9a-f]{32}$",
            "action": "qr_take",
            "param": "code",
            "take": {
                "token": "token",
                "sid": "sid",
                "login": "login"
            },
            "ttl": 600,
            "errors": {
                "400": "Код не того вида — ссылка обрезана или испорчена.",
                "410": "Код устарел или уже использован, либо сотрудника нет или он ждёт роли — сделайте новый на складе: «Подключить Связного».",
                "429": "Слишком много попыток с этого адреса — подождите десять минут."
            },
            "body": {
                "scope": "assist"
            },
            "device": "device"
        },
        "logout": {
            "_": "Выход склада 1.4.62 под вторым именем (auth_out — основное): снимает только тот личный ключ, что пришёл в заголовке. Повтор — ok, ended:false.",
            "action": "sess_end",
            "needs": [
                "token",
                "sid"
            ],
            "ok": "ok",
            "ended": "ended"
        },
        "me": {
            "_": "Кто вошёл и что ему можно (склад 1.4.61 halowarekeep, 1.4.62 DepotDesk): имя, роль, права. Только чтение.",
            "action": "ask_me",
            "all": "all",
            "perms": "perms"
        }
    },
    "links": {
        "sku": {
            "label": "Карточка артикула"
        },
        "cell": {
            "label": "Ячейка на схеме"
        },
        "entry": {
            "label": "Приход"
        }
    },
    "fallback": "where",
    "filler": [
        "покажи",
        "подскажи",
        "скажи",
        "пожалуйста",
        "а",
        "ну",
        "мне"
    ],
    "gen": {
        "_": "Для генератора (tools/assistant/gen.mjs): функции, которые пишут только служебное, а не данные склада. db() кладёт метку базы в data/.",
        "safe": [
            "db"
        ]
    },
    "actions": [
        {
            "_": "Действия с записью (1.4.57). Помощник берёт их только из своей встроенной копии описания; тела запросов, карточку и ответы задаёт его код по kind. Сначала расчёт check (только чтение) — карточка, потом write — по кнопке «Подтвердить».",
            "id": "move",
            "kind": "move",
            "title": "Переместить товар в другую ячейку",
            "access": "staff",
            "say": [
                "перемести {what} из {from} в {to}",
                "переложи {what} из {from} в {to}",
                "перемести {what} из {from}",
                "переложи {what} из {from}",
                "перемести {what} в {to}",
                "переложи {what} в {to}"
            ],
            "examples": [
                "перемести 3 венских стула из 215-1-1-1 в 215-3-2-1",
                "переложи 64115 из 215-1-1-1"
            ],
            "slots": {
                "what": {
                    "label": "сколько и что: число, артикул или название, класс",
                    "type": "text"
                },
                "from": {
                    "label": "ячейка, откуда",
                    "type": "cell",
                    "shape": "^(\\d{3}[a-zа-яё]*(\\s*-\\s*([0-9a-zа-яё]+|[a-zа-яё]+ (?!(?:(?:после)?завтра|сегодня|утр(?:ом|ечком)|дн[её]м|вечер(?:ом|ком)|ночью|срочно)(?![a-zа-яё]))[a-zа-яё]+))+|\\d{3}[a-zа-яё]+|без места)$"
                },
                "to": {
                    "label": "ячейка, куда (зона — и с пробелом: 303-зона приёмки)",
                    "type": "cell",
                    "shape": "^(\\d{3}[a-zа-яё]*(\\s*-\\s*([0-9a-zа-яё]+|[a-zа-яё]+ (?!(?:(?:после)?завтра|сегодня|утр(?:ом|ечком)|дн[её]м|вечер(?:ом|ком)|ночью|срочно)(?![a-zа-яё]))[a-zа-яё]+))+|\\d{3}[a-zа-яё]+|без места)$"
                }
            },
            "check": "act_move_check",
            "write": "act_move",
            "right": "moves"
        },
        {
            "id": "post",
            "kind": "post",
            "title": "Отметить проведение прихода",
            "access": "staff",
            "say": [
                "проведи приход {no} в 1с",
                "проведи приход {no} в 1c",
                "проведи приход {no} в sv",
                "проведи приход {no} в св",
                "проведи приход {no}",
                "отметь проведение прихода {no}",
                "приход {no} проведён в 1с",
                "приход {no} проведён в 1c",
                "приход {no} проведён в sv",
                "приход {no} проведён"
            ],
            "examples": [
                "проведи приход 318 в 1с",
                "проведи приход 318-26"
            ],
            "slots": {
                "no": {
                    "label": "номер прихода, можно с годом: 318 или 318-26 (в номере есть цифра)",
                    "type": "text",
                    "shape": "^[A-Za-zА-Яа-я]{0,5}[0-9][0-9A-Za-zА-Яа-я]{0,5}(-[0-9]{1,9})?$"
                }
            },
            "check": "act_post_check",
            "write": "act_post",
            "right": "post"
        }
    ],
    "commands": [
        {
            "id": "where",
            "title": "Где лежит товар",
            "say": [
                "где лежит {q}",
                "где лежат {q}",
                "где находится {q}",
                "где находятся {q}",
                "где {q}",
                "найди {q}",
                "найти {q}",
                "поиск {q}",
                "{q} где лежит",
                "{q} где"
            ],
            "examples": [
                "где лежит 64115",
                "где стул венский"
            ],
            "slots": {
                "q": {
                    "label": "артикул или название",
                    "type": "text"
                }
            },
            "access": "shared",
            "call": {
                "action": "ask_stock",
                "body": {
                    "q": "{q}"
                }
            },
            "answer": {
                "say": "«{q}»: {count|plural:позиция,позиции,позиций}, всего {qty|num} шт.",
                "empty": "«{q}» на складе нет — ни по артикулу, ни по названию.",
                "list": "items",
                "more": "more",
                "item": {
                    "title": "{sku|or:без артикула}",
                    "text": "{name}",
                    "badge": "{qty|num} шт.",
                    "link": {
                        "kind": "sku",
                        "id": "{sku}"
                    },
                    "list": "cells",
                    "item": {
                        "max": 8,
                        "title": "{cell}",
                        "text": "{clsLabel}",
                        "badge": "{qty|num} шт.",
                        "link": {
                            "kind": "cell",
                            "id": "{cell}"
                        }
                    }
                }
            }
        },
        {
            "id": "count",
            "title": "Сколько осталось",
            "say": [
                "сколько {q}",
                "сколько осталось {q}",
                "сколько есть {q}",
                "сколько штук {q}",
                "сколько у нас {q}",
                "остаток {q}",
                "остатки {q}",
                "{q} сколько"
            ],
            "examples": [
                "сколько венских стульев",
                "остаток 64115"
            ],
            "slots": {
                "q": {
                    "label": "артикул или название",
                    "type": "text"
                }
            },
            "access": "shared",
            "call": {
                "action": "ask_stock",
                "body": {
                    "q": "{q}"
                }
            },
            "answer": {
