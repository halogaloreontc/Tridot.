<?xml version="1.0" encoding="utf-8"?>
<!-- «Сегодня и ввод» (ADR-034): по умолчанию 4×3. Не ниже 175 dp: шапка
     40, одна строка задачи 48 и поле «Что сделать?» 48 с отступами 4 + 8
     (HomeScreenRenderer.Metrics) и запас на крупный шрифт (до 130 % и
     чуть больше). Поле не пропадает ни при каком размере. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="175dp"
    android:maxResizeHeight="520dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|not_keyguard"
    android:initialLayout="@layout/hw_loading"
    android:previewLayout="@layout/hw_combo_preview"
    android:description="@string/hw_combo_description" />
