<?xml version="1.0" encoding="utf-8"?>
<!-- Строка задачи на узком виджете (уже 250 dp с поправкой на масштаб
     шрифта или с длинным сроком): срок под названием, записей нет.
     Кружок — напротив названия, как в hw_row_note.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/hw_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="top"
        android:baselineAligned="false"
        android:background="@drawable/hw_press_bg">
        <FrameLayout
            android:id="@+id/hw_check"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:background="@drawable/hw_press_bg">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="8dp">
                <TextView
                    style="@style/HwTitle"
                    android:layout_width="match_parent"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:importantForAccessibility="no"
                    android:visibility="invisible" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hw_check_off" />
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingEnd="16dp">
            <TextView
                android:id="@+id/hw_title"
                style="@style/HwTitle"
                android:layout_width="match_parent" />
            <TextView
                android:id="@+id/hw_due"
                style="@style/HwDue"
                android:layout_width="match_parent"
                android:layout_marginTop="2dp" />
            <TextView
                android:id="@+id/hw_due_over"
                style="@style/HwDueOver"
                android:layout_width="match_parent"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/hw_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_gravity="top"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="16dp"
        android:background="@color/hw_divider" />
</FrameLayout>
