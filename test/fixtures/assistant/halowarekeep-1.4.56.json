{
    "format": "assistant/1",
    "version": "1.4.56",
    "app": {
        "id": "halowarekeep",
        "title": "Склад halowarekeep",
        "lang": "ru",
        "about": "Склад возвратов: приходы по реестрам, ячейки на схеме, остатки, снимки товара."
    },
    "api": {
        "url": "api.php",
        "method": "POST",
        "action": {
            "in": "query",
            "name": "action"
        },
        "body": "json",
        "only": ["ask_stock", "ask_cell", "ask_arrivals", "ask_nophoto"],
        "errors": {
            "message": "error",
            "need": "need"
        }
    },
    "auth": {
        "headers": {
            "X-Wh-Token": "{$token}",
            "X-Wh-Sid": "{$sid}"
        },
        "credentials": {
            "token": {
                "label": "Пароль склада",
                "app": "localStorage:wh_token"
            },
            "sid": {
                "label": "Личный ключ сотрудника",
                "app": "localStorage:wh_sid",
                "get": {
                    "action": "auth_check",
                    "body": {
                        "login": "{login}",
                        "pass": "{pass}"
                    },
                    "take": "sid"
                }
            }
        },
        "access": {
            "shared": {
                "label": "по паролю склада",
                "needs": ["token"]
            },
            "staff": {
                "label": "под своим логином",
                "needs": ["token", "sid"]
            }
        },
        "need": {
            "login": "Это видно только под своим логином — войдите в склад и спросите снова.",
            "role": "Учётная запись ждёт роли — попросите администратора её назначить."
        },
        "qr": {
            "_": "Вход по одноразовой ссылке из окна «Войти на телефоне» (Профиль). Человек вставляет ссылку в помощник, помощник сам зовёт действие — без пароля склада. Камерой телефона ссылку не открывать: код сработает один раз.",
            "link": "#qr=",
            "shape": "^[0-9a-f]{32}$",
            "action": "qr_take",
            "param": "code",
            "take": {
                "token": "token",
                "sid": "sid",
                "login": "login"
            },
            "ttl": 120,
            "errors": {
                "400": "Код не того вида — ссылка обрезана или испорчена.",
                "410": "Код устарел или уже использован, либо сотрудника нет или он ждёт роли — сделайте новый в окне «Войти на телефоне».",
                "429": "Слишком много попыток с этого адреса — подождите десять минут."
            }
        },
        "logout": {
            "_": "Выход: снимает только тот личный ключ, что пришёл в заголовке. Повтор и уже снятый ключ — тоже ok, ended:false.",
            "action": "sess_end",
            "needs": ["token", "sid"],
            "ok": "ok",
            "ended": "ended"
        }
    },
    "links": {
        "sku": {
            "label": "Карточка артикула"
        },
        "cell": {
            "label": "Ячейка на схеме"
        },
        "entry": {
            "label": "Приход"
        }
    },
    "fallback": "where",
    "filler": ["покажи", "подскажи", "скажи", "пожалуйста", "а", "ну", "мне"],
    "gen": {
        "_": "Для генератора (tools/assistant/gen.mjs): функции, которые пишут только служебное, а не данные склада. db() кладёт метку базы в data/.",
        "safe": ["db"]
    },
    "commands": [
        {
            "id": "where",
            "title": "Где лежит товар",
            "say": [
                "где лежит {q}",
                "где лежат {q}",
                "где находится {q}",
                "где находятся {q}",
                "где {q}",
                "найди {q}",
                "найти {q}",
                "поиск {q}",
                "{q} где лежит",
                "{q} где"
            ],
            "examples": ["где лежит 64115", "где стул венский"],
            "slots": {
                "q": {
                    "label": "артикул или название",
                    "type": "text"
                }
            },
            "access": "shared",
            "call": {
                "action": "ask_stock",
                "body": {
                    "q": "{q}"
                }
            },
            "answer": {
                "say": "«{q}»: {count|plural:позиция,позиции,позиций}, всего {qty|num} шт.",
                "empty": "«{q}» на складе нет — ни по артикулу, ни по названию.",
                "list": "items",
                "more": "more",
                "item": {
                    "title": "{sku|or:без артикула}",
                    "text": "{name}",
                    "badge": "{qty|num} шт.",
                    "link": {
                        "kind": "sku",
                        "id": "{sku}"
                    },
                    "list": "cells",
                    "item": {
                        "max": 8,
                        "title": "{cell}",
                        "text": "{clsLabel}",
                        "badge": "{qty|num} шт.",
                        "link": {
                            "kind": "cell",
                            "id": "{cell}"
                        }
                    }
                }
            }
        },
        {
            "id": "count",
            "title": "Сколько осталось",
            "say": [
                "сколько {q}",
                "сколько осталось {q}",
                "сколько есть {q}",
                "сколько штук {q}",
                "сколько у нас {q}",
                "остаток {q}",
                "остатки {q}",
                "{q} сколько"
            ],
            "examples": ["сколько венских стульев", "остаток 64115"],
            "slots": {
                "q": {
                    "label": "артикул или название",
                    "type": "text"
                }
            },
            "access": "shared",
            "call": {
                "action": "ask_stock",
                "body": {
                    "q": "{q}"
                }
            },
            "answer": {
                "say": "«{q}»: всего {qty|num} шт. — {count|plural:позиция,позиции,позиций}.",
                "empty": "«{q}» на складе нет — 0 шт.",
                "list": "items",
                "more": "more",
                "item": {
                    "title": "{sku|or:без артикула}",
                    "text": "{name}",
                    "badge": "{qty|num} шт.",
                    "link": {
                        "kind": "sku",
                        "id": "{sku}"
                    },
                    "list": "sheets",
                    "item": {
                        "title": "склад {sheet}",
                        "badge": "{qty|num} шт."
                    }
                }
            }
        },
        {
            "id": "price",
            "title": "Цена товара",
            "say": ["сколько стоит {q}", "цена {q}", "почем {q}", "какая цена {q}"],
            "examples": ["сколько стоит 64115"],
            "slots": {
                "q": {
                    "label": "артикул или название",
                    "type": "text"
                }
            },
            "reply": "Цены помощник пока не называет — откройте карточку артикула: там цена и как она посчитана."
        },
        {
            "id": "cell",
            "title": "Что лежит в ячейке",
            "say": [
                "что лежит в {cell}",
                "что лежит в ячейке {cell}",
                "что в ячейке {cell}",
                "что в стеллаже {cell}",
                "что на стеллаже {cell}",
                "что лежит в стеллаже {cell}",
                "что лежит на стеллаже {cell}",
                "что на складе {cell}",
                "что на {cell}",
                "что лежит на {cell}",
                "что в {cell}",
                "ячейка {cell}",
                "стеллаж {cell}",
                "{cell}"
            ],
            "examples": ["что в ячейке 215-1-1-1", "стеллаж 215-3"],
            "slots": {
                "cell": {
                    "label": "код ячейки, стеллажа или склада",
                    "type": "cell",
                    "shape": "^(\\d{3}[a-zа-я]*(\\s*-\\s*[0-9a-zа-я]+)+|\\d{3}[a-zа-я]+|без места)$"
                }
            },
            "access": "shared",
            "call": {
                "action": "ask_cell",
                "body": {
                    "cell": "{cell}"
                }
            },
            "answer": {
                "say": "{cell}: {count|plural:строка,строки,строк}, {qty|num} шт. — {cells|plural:ячейка,ячейки,ячеек}",
                "empty": "В {cell} пусто или такой ячейки нет.",
                "list": "items",
                "more": "more",
                "links": [
                    {
                        "kind": "cell",
                        "id": "{cell}",
                        "label": "Открыть на схеме",
                        "if": "exact"
                    }
                ],
                "item": {
                    "title": "{sku|or:без артикула}",
                    "text": "{name}",
                    "note": "{cell} · {clsLabel}",
                    "badge": "{qty|num} шт.",
                    "link": {
                        "kind": "sku",
                        "id": "{sku}"
                    }
                }
            }
        },
        {
            "id": "today",
            "title": "Что пришло сегодня",
            "say": [
                "что пришло сегодня",
                "что сегодня пришло",
                "приходы сегодня",
                "приходы за сегодня",
                "сегодняшние приходы",
                "что пришло",
                "сегодня",
                "что пришло за сегодня",
                "какие приходы сегодня",
                "сколько пришло сегодня",
                "сколько приходов сегодня",
                "сколько пришло",
                "сколько приходов"
            ],
            "examples": ["что пришло сегодня"],
            "slots": {},
            "access": "staff",
            "call": {
                "action": "ask_arrivals",
                "body": {
                    "from": "{$today}",
                    "to": "{$today}",
                    "tz": "{$tz}",
                    "zone": "{$zone}"
                }
            },
            "answer": {
                "say": "Сегодня {count|plural:приход,прихода,приходов}, {qty|num} шт.",
                "empty": "Сегодня приходов не было.",
                "list": "items",
                "more": "more",
                "item": {
                    "title": "{no|or:без номера}",
                    "text": "{kindLabel} · {time}",
                    "note": "{reason}",
                    "badge": "{positions|plural:позиция,позиции,позиций}",
                    "link": {
                        "kind": "entry",
                        "id": "{id}"
                    }
                }
            }
        },
        {
            "id": "yesterday",
            "title": "Что пришло вчера",
            "say": [
                "что пришло вчера",
                "что вчера пришло",
                "приходы вчера",
                "приходы за вчера",
                "вчера",
                "что пришло за вчера",
                "какие приходы вчера",
                "сколько пришло вчера",
                "сколько приходов вчера"
            ],
            "examples": ["что пришло вчера"],
            "slots": {},
            "access": "staff",
            "call": {
                "action": "ask_arrivals",
                "body": {
                    "from": "{$yesterday}",
                    "to": "{$yesterday}",
                    "tz": "{$tz}",
                    "zone": "{$zone}"
                }
            },
            "answer": {
                "say": "Вчера {count|plural:приход,прихода,приходов}, {qty|num} шт.",
                "empty": "Вчера приходов не было.",
                "list": "items",
                "more": "more",
                "item": {
                    "title": "{no|or:без номера}",
                    "text": "{kindLabel} · {time}",
                    "note": "{reason}",
                    "badge": "{positions|plural:позиция,позиции,позиций}",
                    "link": {
                        "kind": "entry",
                        "id": "{id}"
                    }
                }
            }
        },
        {
            "id": "week",
            "title": "Приходы за неделю",
            "say": [
                "что пришло за неделю",
                "приходы за неделю",
                "за неделю",
                "приходы за 7 дней",
                "за 7 дней",
                "сколько пришло за неделю",
                "сколько приходов за неделю",
                "какие приходы за неделю"
            ],
            "examples": ["что пришло за неделю"],
            "slots": {},
            "access": "staff",
            "call": {
                "action": "ask_arrivals",
                "body": {
                    "from": "{$today-6}",
                    "to": "{$today}",
                    "tz": "{$tz}",
                    "zone": "{$zone}"
                }
            },
            "answer": {
                "say": "За неделю {count|plural:приход,прихода,приходов}, {qty|num} шт.",
                "empty": "За неделю приходов не было.",
                "list": "items",
                "more": "more",
                "item": {
                    "title": "{no|or:без номера}",
                    "text": "{kindLabel} · {day|date} {time}",
                    "note": "{reason}",
                    "badge": "{positions|plural:позиция,позиции,позиций}",
                    "link": {
                        "kind": "entry",
                        "id": "{id}"
                    }
                }
            }
        },
        {
            "id": "nophoto",
            "title": "Приходы без фото",
            "say": [
                "какие приходы без фото",
                "приходы без фото",
                "приходы без снимков",
                "где нет фото",
                "что без фото",
                "без фото",
                "без снимков",
                "где нет снимков",
                "где без фото",
                "приходы без фотографий",
                "без фотографий"
            ],
            "examples": ["какие приходы без фото"],
            "slots": {},
            "access": "staff",
            "call": {
                "action": "ask_nophoto",
                "body": {
                    "days": 30,
                    "tz": "{$tz}",
                    "zone": "{$zone}"
                }
            },
            "answer": {
                "say": "За {days} дней без снимков — {count|plural:приход,прихода,приходов}, {missing|plural:позиция,позиции,позиций}.",
                "empty": "За {days} дней все позиции приходов со снимками.",
                "list": "items",
                "more": "more",
                "item": {
                    "title": "{no|or:без номера}",
                    "text": "{kindLabel} · {day|date}",
                    "note": "{skus}{scan|unless: · скан не прикреплён}",
                    "badge": "{missing} из {total}",
                    "link": {
                        "kind": "entry",
                        "id": "{id}"
                    }
                }
            }
        },
        {
            "id": "help",
            "title": "Что умеет помощник",
            "say": [
                "помощь",
                "что ты умеешь",
                "что умеешь",
                "что можешь",
                "команды",
                "привет",
                "что ты можешь",
                "как тобой пользоваться"
            ],
            "examples": ["что ты умеешь"],
            "slots": {},
            "help": true
        }
    ]
}
