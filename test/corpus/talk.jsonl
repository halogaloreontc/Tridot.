{"id": "talk-157", "text": "Связной, привет", "connector": "talk", "intent": "talk.greet", "note": "обращение к главному по имени (ADR-016, ADR-017)", "source": "manual"}
{"id": "talk-158", "text": "Связной, добавь задачу хлеб", "connector": "tasks", "intent": "createTask", "title": "Хлеб", "note": "обращение к главному по имени не попадает в название", "source": "manual"}
{"id": "talk-159", "text": "включи трио", "connector": "talk", "intent": "talk.setting", "note": "режим команды: Трио (ADR-016)", "source": "manual"}
